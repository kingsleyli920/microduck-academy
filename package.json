{
  "name": "microduck-academy",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "A bilingual, local-first reinforcement learning classroom for Microduck.",
  "keywords": [
    "reinforcement-learning",
    "robotics",
    "microduck",
    "mujoco",
    "onnx",
    "education"
  ],
  "homepage": "https://github.com/kingsleyli920/microduck-academy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsleyli920/microduck-academy.git"
  },
  "bugs": {
    "url": "https://github.com/kingsleyli920/microduck-academy/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "academy": "node scripts/server-control.mjs",
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release": "node scripts/check-release.mjs",
    "sync:simulator": "node scripts/sync-simulator.mjs",
    "lint": "oxlint app components lib scripts tests",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:release && npm run check:docs && npm test && npm run lint && npm run typecheck && npm run build",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "pyodide": "^0.29.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  },
  "type": "module"
}
